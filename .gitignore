# --- Секреты: токены бота и ключи API ---
.env

# --- Виртуальное окружение ---
.venv/
venv/

# --- Python: кэш байт-кода и служебные файлы ---
__pycache__/
*.py[cod]
*.pyo

# --- База данных памяти бота (создаётся автоматически) ---
memory.db
memory.db-wal
memory.db-shm

# --- Pinecone SDK: локальная конфигурация и кэш ---
.pinecone.yaml
.pinecone/

# --- Демонстрационные файлы базы (если скачиваются локально) ---
*.parquet

# --- Редакторы и IDE ---
.vscode/
.idea/
*.swp

# --- Операционная система ---
Thumbs.db
.DS_Store
