# Токен Telegram-бота, полученный у @BotFather (ОБЯЗАТЕЛЬНО)
TG_BOT_API_KEY=your_telegram_bot_token

# Ключ ProxyAPI (OpenAI-совместимый провайдер) (ОБЯЗАТЕЛЬНО)
PROXYAPI_API_KEY=your_proxyapi_key

# Базовый URL ProxyAPI (OpenAI-совместимый эндпоинт)
PROXYAPI_API_BASE=https://api.proxyapi.ru/v1

# Имя модели, которую использует бот
LLM_MODEL=openai/gpt-5.6-luna

# Таймаут одного запроса к LLM в секундах (НЕОБЯЗАТЕЛЬНО, по умолчанию 60)
LLM_TIMEOUT=60

# Число автоматических повторов запроса при сбое (НЕОБЯЗАТЕЛЬНО, по умолчанию 2)
LLM_MAX_RETRIES=2

# Путь к файлу базы долговременной памяти бота (НЕОБЯЗАТЕЛЬНО, по умолчанию memory.db)
MEMORY_DB_PATH=memory.db

# Размер краткой истории диалога в памяти (НЕОБЯЗАТЕЛЬНО, по умолчанию 20 сообщений)
HISTORY_LIMIT=20

# API-ключ Pinecone (получить в консоли https://app.pinecone.io) (ОБЯЗАТЕЛЬНО для pine.py)
PINECONE_API_KEY=your_pinecone_api_key

# Имя векторного индекса Pinecone (НЕОБЯЗАТЕЛЬНО, по умолчанию "bot-memory")
PINECONE_INDEX_NAME=bot-memory

# Облако и регион для создания индекса (НЕОБЯЗАТЕЛЬНО, используются только при первом создании)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1